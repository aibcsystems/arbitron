# ARBITRON v4 — local environment template
#
# Copy this file to `.env` and fill in real credentials there.
# `.env` is gitignored — it should never be committed, and its
# contents should never be pasted into a chat, ticket, or log.
#
#   cp .env.example .env
#   # edit .env directly in a text editor
#   set -a && source .env && set +a   # loads into current shell
#   go run ./cmd/pipelinetest -symbol=BTC/USD
#
# Every var below is read via config.Load() in config/config.go —
# this list was generated directly from that file, not by hand, so
# it stays accurate as the config grows. Values shown after "=" for
# non-secret vars are the actual defaults config.go falls back to if
# unset — only override if you want something different.

# ── Binance USDM Futures ─────────────────────────────────────
BINANCE_WS_URL=wss://fstream.binance.com/ws
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Kraken Perpetuals ─────────────────────────────────────────
KRAKEN_WS_URL=wss://futures.kraken.com/ws/v1
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ── Alpaca Spot Crypto ────────────────────────────────────────
# Base URL is set separately at the shell/CLI level (ALPACA_BASE_URL
# in smoketest/pipelinetest usage), not read by config.go itself.
ALPACA_WS_URL=wss://stream.data.alpaca.markets/v1beta3/crypto/us
ALPACA_API_KEY=
ALPACA_API_SECRET=

# ── FIX Direct Gateway ────────────────────────────────────────
# Parked — no counterparty yet. Fill in once a real FIX venue
# relationship exists; until then these stay blank.
FIX_GATEWAY_URL=tcp://fix-gateway:9878
FIX_SENDER_COMP_ID=ARBITRON
FIX_TARGET_COMP_ID=BROKER
FIX_USERNAME=
FIX_PASSWORD=

# ── Infrastructure ────────────────────────────────────────────
REDIS_ADDR=localhost:6379
POSTGRES_URL=postgres://arbitron:arbitron@localhost:5432/arbitron?sslmode=disable
GATEWAY_ADDR=:8080

# ── Risk parameters ───────────────────────────────────────────
RISK_MAX_LATENCY_MS=45
RISK_DAILY_LOSS_LIMIT=50000.0
RISK_MAX_DRAWDOWN=0.10
RISK_LEG_TIMEOUT_MS=45
RISK_LEG_TIMEOUT_MS_ALPACA=2000
RISK_MAX_ORDERS_SEC=50
RISK_MAX_POSITION_USD=5000.0
RISK_MIN_POSITION_USD=50.0
RISK_BASE_RISK_PCT=0.02

# ── Fee schedule (bps as decimals) ────────────────────────────
FEE_BINANCE_USDM=0.0005
FEE_KRAKEN_PERP=0.00075
FEE_ALPACA_SPOT=0.0015
FEE_FIX_DIRECT=0.0004
FEE_DEFAULT=0.0010

# ── Telemetry pipeline ────────────────────────────────────────
STREAM_FLUSH_INTERVAL=500ms
STREAM_MAX_BATCH_SIZE=500
TELEMETRY_STREAM_KEY=arbitron:telemetry
EXECUTION_STREAM_KEY=arbitron:execution
