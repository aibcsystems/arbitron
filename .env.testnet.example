# ============================================================
#  ARBITRON v4 — TESTNET environment template
#  For checklist Sections 1 & 2 (Binance + Kraken testnet).
#
#  Copy to `.env`, fill in the two credential pairs below with
#  TESTNET keys only. Never put production keys in this file.
#  `.env` is already gitignored.
# ============================================================

# --- Core infra (adjust if not running Redis/Postgres locally) ---
REDIS_ADDR=localhost:6379
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/arbitron?sslmode=disable
GATEWAY_ADDR=:8080

# --- Binance USD-M Futures TESTNET ---
# Get keys at https://testnet.binancefuture.com (separate account, free fake balance)
# binance.go already supports this override env var directly:
BINANCE_BASE_URL=https://testnet.binancefuture.com
BINANCE_WS_URL=wss://stream.binancefuture.com/ws
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Kraken Futures TESTNET (demo) ---
# Get keys at https://demo-futures.kraken.com
# kraken.go now supports this override too (patched — previously hardcoded):
KRAKEN_BASE_URL=https://demo-futures.kraken.com
KRAKEN_WS_URL=wss://demo-futures.kraken.com/ws/v1
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Alpaca / FIX — leave blank, not in scope for Sections 1-2 ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
FIX_USERNAME=
FIX_PASSWORD=

# --- Risk params (safe defaults for testnet dry runs) ---
RISK_MAX_LATENCY_MS=45
RISK_DAILY_LOSS_LIMIT=50000.0
RISK_MAX_DRAWDOWN=0.10
RISK_MAX_POSITION_USD=100.0
RISK_MIN_POSITION_USD=10.0
